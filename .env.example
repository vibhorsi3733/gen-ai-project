# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Both keys are optional. Set ONE of them (or both):
#   - only GEMINI_API_KEY      -> Gemini tags   (default model gemini-3.8-flash)
#   - only ANTHROPIC_API_KEY   -> Claude tags   (default model claude-opus-5-5)
#   - both                     -> Claude, unless LLM_PROVIDER=gemini or TAG_MODEL=gemini-...
#   - neither                  -> keyword tags only (no LLM, no cost)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional
# LLM_PROVIDER=gemini          # anthropic | gemini: which one to prefer when both keys are set
# TAG_MODEL=gemini-3.8-flash   # any claude-* or gemini-* model id
# TAG_EFFORT=low               # low | medium | high (Claude effort / Gemini thinking level)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
